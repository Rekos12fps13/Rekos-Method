{
  "manifest_version":3,
  "name":"Rekos Uploader",
  "version":"1.0.0",
  "description":"HD/4K multi-video preview and TikTok upload quality assistant.",
  "permissions":["storage","activeTab"],
  "host_permissions":["https://www.tiktok.com/*","https://*.tiktok.com/*"],
  "action":{"default_title":"Rekos Uploader","default_popup":"popup.html"},
  "options_page":"options.html",
  "content_scripts":[{"matches":["https://www.tiktok.com/*","https://*.tiktok.com/*"],"js":["content.js"],"css":["content.css"],"run_at":"document_idle"}],
  "icons":{"16":"icons/icon16.svg","32":"icons/icon32.svg","48":"icons/icon48.svg","128":"icons/icon128.svg"},
  "content_security_policy":{"extension_pages":"script-src 'self'; object-src 'self';"}
}